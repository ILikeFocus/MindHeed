<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MindHeed" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/mh_indigo</item>
        <item name="android:colorAccent">@color/mh_violet</item>
        <item name="android:windowBackground">@color/mh_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/mh_text</item>
    </style>

    <style name="MindHeed.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="MindHeed.CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mh_text</item>
    </style>

    <style name="MindHeed.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mh_text_muted</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="MindHeed.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mh_text</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="MindHeed.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MindHeed.LinkButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/mh_violet</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>
